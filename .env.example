# ── Database (Turso / libSQL) ─────────────────────────────────────────────
# Local dev works with a plain file: TURSO_DATABASE_URL=file:local.db
# (leave TURSO_AUTH_TOKEN empty for file databases)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── File storage (Vercel Blob, private store) ─────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── The gate ──────────────────────────────────────────────────────────────
# The one password shared with all participants. Unset = open in local dev,
# 503 on a real deployment (fail-closed).
PORTAL_PASSWORD=

# ── Email (Resend) — optional; the portal works without it ────────────────
# MAIL_FROM example:  Seminar <noreply@your-domain.example>
RESEND_API_KEY=
MAIL_FROM=

# Absolute URL of the deployed site, used in notification emails.
PORTAL_PUBLIC_URL=
